# HeatShield Backend — Environment Variables
# Copy this file to .env and fill in your values.

# Server
PORT=3001

# LLM Configuration
# Provider: openai | anthropic | google (adjust SynthesisService.js accordingly)
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_api_key_here

# Optional: override Open-Meteo base URL (leave blank to use default)
OPEN_METEO_BASE_URL=
